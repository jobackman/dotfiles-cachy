# Python test/import artifacts
__pycache__/
*.pyc

# Raw Noctalia state must never be tracked (use the sanitized snapshot).
noctalia/.local/state/noctalia/

# Editor and temporary files
*~
*.bak
*.swp

# Never version Fish universal variables or dotenv files.
**/fish_variables
**/.env
**/.env.*

# Noctalia generates these themes from its own tracked configuration.
terminal/.config/kitty/themes/noctalia.conf
tools/.config/zed/themes/noctalia.json
